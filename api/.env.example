# Copy to .env only for a private deployment; leave blank rather than using demo values.
APP_ENV=production
PUBLIC_ORIGIN=
DATABASE_URL=
REDIS_URL=redis://redis:6379/0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
DATA_ENCRYPTION_KEY=
API_KEY_PEPPER=
PAYPAL_MODE=live
# Live credentials and plans. These are selected only when PAYPAL_MODE=live.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_INDIVIDUAL_PLAN_ID=
PAYPAL_CLINIC_PLAN_ID=
# Sandbox credentials and plans. These are selected only when PAYPAL_MODE=sandbox.
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
PAYPAL_SANDBOX_WEBHOOK_ID=
PAYPAL_SANDBOX_INDIVIDUAL_PLAN_ID=
PAYPAL_SANDBOX_CLINIC_PLAN_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
ALLOWED_ORIGINS=
